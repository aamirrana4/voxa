# Copy this file to .env (or set the variables in your hosting dashboard).
# NEVER commit real keys to git or paste them into frontend code.

# Ai33 API key (xi-api-key). Server-side only.
AI33_API_KEY=<redacted>

# Random secret for login sessions. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Database. Local dev: leave empty (uses backend/voxa.db SQLite file).
# Production: persistent Postgres URL, e.g. a free Neon project (pooled connection string).
DATABASE_URL=

# Your email address (comma-separated if several). Anyone signing up with one of
# these emails automatically becomes an admin.
ADMIN_EMAIL=you@example.com

# Free credits every new signup gets to try the tools.
SIGNUP_BONUS=1000

# Set to 1 on hosts serving HTTPS (e.g. Render) so the login cookie is Secure.
COOKIE_SECURE=0

# Optional: port the server listens on (hosting providers usually set PORT).
PORT=5000
